<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Бесшовный запуск (владелец 2026-08-23): знак внутри launch_logo смещён
         и отмасштабирован так, чтобы на экране встать ровно в точку, где OEM-зум
         плитки лаунчера заканчивается (рамка ~90dp в центре экрана) — зум
         перетекает в сплэш-иконку, Flutter-кадр повторяет её 1:1. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_logo</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>