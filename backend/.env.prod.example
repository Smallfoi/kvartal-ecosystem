# Прод-окружение STAW backend.
# СКОПИРОВАТЬ в backend/.env (он в .gitignore — НЕ коммитить!) и ЗАПОЛНИТЬ.
# Сильные секреты: python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Без заполнения секретов приложение НЕ стартует (fail-fast, common/prodcheck.py).

# ── Django ──────────────────────────────────────────────────────────────────
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=ЗАМЕНИ_сильным_секретом
JWT_SECRET=ЗАМЕНИ_ДРУГИМ_сильным_секретом
DJANGO_ALLOWED_HOSTS=api.staw.ru
# Откуда фронт/сайт ходят (CORS + CSRF для админки за HTTPS):
DJANGO_CORS_ORIGINS=https://staw.ru,https://www.staw.ru

# ── PostgreSQL/PostGIS ──────────────────────────────────────────────────────
POSTGRES_DB=staw
POSTGRES_USER=staw
POSTGRES_PASSWORD=ЗАМЕНИ_сильным_паролем_БД
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Redis (общий кэш: rate-limit/OTP/бан/баланс, D-07/D-28) ───────────────────
# Без REDIS_URL — LocMem (dev, один процесс). В проде ОБЯЗАТЕЛЕН (несколько воркеров).
REDIS_URL=redis://redis:6379/0

# ── SMS-вход (D-24) ──────────────────────────────────────────────────────────
# Без SMS_PROVIDER — dev-режим: код входа всегда 1234, реальные SMS не шлются.
# Боевой вход: SMS_PROVIDER=smsc + логин/пароль smsc.ru.
# SMS_PROVIDER=smsc
# SMS_LOGIN=ваш_логин_smsc
# SMS_PASSWORD=ваш_пароль_smsc

# ── Медиа: объектное хранилище S3 (D-31) ─────────────────────────────────────
# Без ВСЕХ трёх обязательных ключей — локальный диск /srv/media (dev-режим).
# Yandex Object Storage: бакет + сервисный аккаунт с ролью storage.editor,
# статический ключ доступа (ID → ACCESS_KEY, секрет → SECRET_KEY).
# MEDIA_S3_BUCKET=staw-media
# MEDIA_S3_ACCESS_KEY=YCAJE...
# MEDIA_S3_SECRET_KEY=YCP...
# Ниже — необязательные (дефолты подходят для Yandex Object Storage):
# MEDIA_S3_ENDPOINT=https://storage.yandexcloud.net
# MEDIA_S3_REGION=ru-central1
# Домен CDN для отдачи медиа (без него URL идут прямо на бакет):
# MEDIA_S3_CUSTOM_DOMAIN=cdn.staw.ru

# ── Бэкапы БД в объектное хранилище (deploy/backup.sh) ───────────────────────
# Без BACKUP_S3_BUCKET дамп остаётся ТОЛЬКО на диске сервера (диск умрёт —
# умрут и БД, и бэкапы). Для прода задать ОБЯЗАТЕЛЬНО, бакет — приватный.
# BACKUP_S3_BUCKET=staw-backups
# Ключи по умолчанию берутся из MEDIA_S3_* — задать, если сервисный аккаунт другой:
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_ENDPOINT=https://storage.yandexcloud.net
# BACKUP_S3_REGION=ru-central1
# Сколько дней хранить локальные дампы (в бакете — политикой жизненного цикла):
# BACKUP_KEEP_DAYS=14

# ── TLS: Let's Encrypt (deploy/tls.sh) ───────────────────────────────────────
# TLS_DOMAIN=api.staw.ru
# TLS_EMAIL=admin@staw.ru

# ── Sentry (мониторинг/краши, D-25: self-host РФ) ────────────────────────────
# Без DSN Sentry не подключается (no-op). Заполнить, когда поднят self-host Sentry.
# SENTRY_DSN=https://<key>@sentry.staw.ru/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0

# ── Оплата заказов (Store) ───────────────────────────────────────────────────
# Провайдер выбирает владелец (ЮKassa/CloudPayments/Тинькофф). Без PAYMENT_PROVIDER
# оплата в dev не требуется (заказ сразу «оплачен»).
# PAYMENT_PROVIDER=yookassa
# YOOKASSA_SHOP_ID=...
# YOOKASSA_SECRET_KEY=...

# ── Пуши вне приложения (D-25: RuStore) ──────────────────────────────────────
# Без PUSH_PROVIDER пуши не шлются (лента уведомлений в приложении работает и так).
# PUSH_PROVIDER=rustore
# RUSTORE_PUSH_KEY=ключ_RuStore_Push

# ── Прочее ──────────────────────────────────────────────────────────────────
# Демо-баллы новичкам — в проде НЕ задавать (по умолчанию выкл). Только для демо: =1
# SEED_DEMO_POINTS=1
DJANGO_MEDIA_ROOT=/srv/media
DJANGO_STATIC_ROOT=/app/staticfiles
